{
  "name": "applybot",
  "productName": "Apply",
  "version": "1.0.3",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "description": "Fill out job applications in seconds",
  "author": "Luis Coronel",
  "build": {
    "appId": "com.lcoronelr.apply",
    "productName": "Apply",
    "artifactName": "Apply-${version}-${arch}.${ext}",
    "directories": {
      "output": "../build/release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/dist/engine",
        "to": "engine"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Apply",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
